layout {

    focus-ring {
        active-color   "%%selection_background.hex%%"
        inactive-color "%%background.hex%%"
        urgent-color   "%%color1.hex%%"
    }

    border {
        active-color   "%%selection_background.hex%%"
        inactive-color "%%background.hex%%"
        urgent-color   "%%color1.hex%%"
    }

    shadow {
        color "0007"
    }

    tab-indicator {
        active-color   "%%selection_background.hex%%"
        inactive-color "%%selection_background.hex%%60"
        urgent-color   "%%color1.hex%%"
    }

    insert-hint {
        color "%%color4.hex%%80"
    }
}
