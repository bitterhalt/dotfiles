{
  // AUDIO
  "pulseaudio": {
    "format": "{icon}",
    "format-icons": [
      "󰕿",
      "󰖀",
      "󰖀",
      "󰕾"
    ],
    "format-muted": "󰝟",
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "scroll-step": 5,
    "tooltip-format": "Vol:\t{volume}%"
  }
}
