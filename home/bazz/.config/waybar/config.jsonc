// IMPORTS
{
  "include": [
    "modules/modules.jsonc",
    "modules/custom-modules.jsonc",
    "modules/groups.jsonc",
  ],

  // SETTINGS
  "layer": "top",
  "position": "top",
  "spacing": 4,

  // LEFT
  "modules-left": ["niri/workspaces", "niri/window"],

  // CENTER
  "modules-center": [
    "group/middle",
    "custom/mako",
    "privacy",
    "custom/wf-recorder",
  ],

  // RIGHT
  "modules-right": [
    "group/connections",
    "pulseaudio",
    "custom/idle",
    "battery",
    "group/hidden-tray",
  ],
}
