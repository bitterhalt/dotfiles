#!/usr/bin/env bash

DMENU="${DMENU:-vicinae dmenu}"
EDITOR="${EDITOR:-nvim}"

SELECTION=$(
  fd -HI -t f \
    --exclude .icons \
    --exclude Pictures \
    --exclude Videos \
    --exclude bin \
    --exclude icons \
    --exclude lib \
    --exclude lib64 \
    --exclude man \
    . \
    "$HOME" \
    /etc \
    /usr \
    /opt \
    /var \
    /srv \
    2>/dev/null |
    while IFS= read -r file; do
      [[ -L "$file" ]] && continue
      printf '%s\n' "$file"
    done |
    $DMENU --placeholder="Find files"
)

[[ -z "$SELECTION" ]] && exit 0

MIME=$(file --mime-type -b "$SELECTION")

if [[ "$MIME" == text/* ||
  "$SELECTION" == *.sh ||
  "$SELECTION" == *.py ||
  "$SELECTION" == *.conf ]]; then

  if [[ "$SELECTION" == "$HOME"* ]]; then
    "${TERMINAL:-foot}" -e "$EDITOR" "$SELECTION" &
  else
    "${TERMINAL:-foot}" -e pkexec "$EDITOR" "$SELECTION" &
  fi
else
  xdg-open "$SELECTION" &
fi

disown
