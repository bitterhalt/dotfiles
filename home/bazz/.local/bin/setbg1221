#!/usr/bin/env python3
"""setbg - set wallpaper, optionally generate a pywal theme and refresh the desktop."""

import argparse
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

BGCOL = "121212"
WALL_DIR = Path.home() / ".local/share/wall"
WALLPAPER = WALL_DIR / "wallpaper.png"
LOCKSCREEN = WALL_DIR / "lockscreen.png"

PORTALS = [
    "xdg-desktop-portal-gtk",
    "xdg-desktop-portal-gnome",
    "xdg-desktop-portal-hyprland",
    "xdg-desktop-portal-wlr",
]
LIBDIRS = ["/usr/lib", "/usr/libexec", "/usr/lib/xdg-desktop-portal"]


# --------------------------------------------------------------------------- #
# helpers
# --------------------------------------------------------------------------- #
def err(msg: str) -> None:
    print(msg, file=sys.stderr)


def run(cmd: list[str], **kwargs) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, **kwargs)


def quiet(cmd: list[str]) -> int:
    """Run a command, discard output, return exit code."""
    return run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode


def is_running(name: str, full: bool = False) -> bool:
    """pgrep wrapper: exact process-name match unless full=True (pgrep -f)."""
    return quiet(["pgrep", "-f" if full else "-x", name]) == 0


def spawn_detached(cmd: list[str]) -> None:
    subprocess.Popen(
        cmd,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


# --------------------------------------------------------------------------- #
# resolution
# --------------------------------------------------------------------------- #
def get_resolution() -> tuple[int, int] | None:
    if shutil.which("wlr-randr") is None:
        err("Error: wlr-randr is not installed.")
        return None

    result = run(["wlr-randr"], capture_output=True, text=True)
    enabled = False
    for line in result.stdout.splitlines():
        if line and not line[0].isspace():
            enabled = False
        if "Enabled: yes" in line:
            enabled = True
        if "current" in line and enabled:
            m = re.search(r"(\d+)x(\d+)", line)
            if m:
                return int(m.group(1)), int(m.group(2))
    return None


# --------------------------------------------------------------------------- #
# wallpaper
# --------------------------------------------------------------------------- #
def apply_wallpaper(path: str) -> bool:
    src = Path(path).expanduser()
    if not src.is_file():
        err(f"Error: '{path}' does not exist.")
        return False

    res = get_resolution()
    if res is None:
        err("Error: failed to detect resolution.")
        return False
    w, h = res

    WALL_DIR.mkdir(parents=True, exist_ok=True)

    if run(
        ["magick", str(src), "-resize", f"{w}x{h}^", "-gravity", "center",
         "-extent", f"{w}x{h}", str(WALLPAPER)]
    ).returncode != 0:
        return False

    run(
        ["awww", "img", str(WALLPAPER),
         "--transition-type=any", "--transition-step=60",
         "--transition-fps=60", "--transition-duration=.7"]
    )

    if run(
        ["magick", str(WALLPAPER), "-blur", "0x55", "-modulate", "80", str(LOCKSCREEN)]
    ).returncode != 0:
        return False

    run(["awww", "img", "-n", "overview", str(LOCKSCREEN), "--transition-type=none"])
    return True


# --------------------------------------------------------------------------- #
# portals
# --------------------------------------------------------------------------- #
def start_from_libdirs(name: str, libdirs: list[str], announce: bool = True) -> None:
    for libdir in libdirs:
        exe = Path(libdir) / name
        if exe.is_file() and os.access(exe, os.X_OK):
            if announce:
                print(f"Manually starting {name} from {libdir}...")
            spawn_detached([str(exe)])
            return


def refresh_portals() -> None:
    for portal in PORTALS:
        if quiet(["systemctl", "--user", "is-active", portal]) == 0:
            print(f"Restarting {portal} via systemd...")
            run(["systemctl", "--user", "restart", portal])
        else:
            if is_running(portal, full=True):
                print(f"Killing active instance of {portal}...")
                quiet(["pkill", "-f", portal])
                time.sleep(0.2)
            start_from_libdirs(portal, LIBDIRS)

    if quiet(["systemctl", "--user", "is-active", "xdg-desktop-portal"]) == 0:
        run(["systemctl", "--user", "restart", "xdg-desktop-portal"])
    else:
        quiet(["pkill", "-f", "xdg-desktop-portal"])
        start_from_libdirs("xdg-desktop-portal", ["/usr/lib", "/usr/libexec"], announce=False)


# --------------------------------------------------------------------------- #
# environment refresh
# --------------------------------------------------------------------------- #
def refresh_env() -> None:
    # Restart waybar unless quickshell (qs) is handling the bar
    if not is_running("qs"):
        quiet(["pkill", "-x", "waybar"])
        spawn_detached(["waybar"])

    # Only touch vicinae if it's actually running
    if is_running("vicinae"):
        run(["vicinae", "theme", "set", "pywal"])

    run(["xrdb", "-merge", "-quiet", str(Path.home() / ".cache/wal/colors.Xresources")])


# --------------------------------------------------------------------------- #
# modes
# --------------------------------------------------------------------------- #
def run_wal(extra: list[str] | None = None) -> None:
    run(["wal", "-e", "-n", "-i", str(WALLPAPER), *(extra or [])])


def mode_setwall(path: str) -> int:
    return 0 if apply_wallpaper(path) else 1


def mode_pywal(path: str) -> int:
    if not apply_wallpaper(path):
        return 1
    run_wal()
    refresh_env()
    refresh_portals()
    return 0


def fuzzel_prompt(options: str | None, placeholder: str) -> str:
    result = run(
        ["fuzzel", "-d", "--minimal-lines", "--placeholder", placeholder],
        input=options or "",
        capture_output=True,
        text=True,
    )
    return result.stdout.strip()


def mode_pywal_fixed(path: str) -> int:
    selection = fuzzel_prompt(f"{BGCOL} (Default)\nCustom", "Select background color: ")

    if selection == "Custom":
        bg = fuzzel_prompt(None, "Enter hex (e.g. 1A1A1A): ").lstrip("#")
    else:
        bg = selection.split()[0] if selection else ""

    if not re.fullmatch(r"[0-9a-fA-F]{6}", bg):
        if bg:
            err(f"Warning: '{bg}' is not a valid 6-digit hex colour, using {BGCOL}.")
        bg = BGCOL

    if not apply_wallpaper(path):
        return 1
    run_wal(["-b", bg])
    refresh_env()
    refresh_portals()
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="setbg", description="Set wallpaper and optionally theme the desktop."
    )
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument("-w", metavar="PATH", help="set wallpaper only")
    group.add_argument("-p", metavar="PATH", help="set wallpaper and generate pywal theme")
    group.add_argument(
        "-pf", metavar="PATH", help="like -p, but pick a fixed background colour via fuzzel"
    )
    args = parser.parse_args()

    if args.w:
        return mode_setwall(args.w)
    if args.p:
        return mode_pywal(args.p)
    return mode_pywal_fixed(args.pf)


if __name__ == "__main__":
    sys.exit(main())
