#!/usr/bin/env bash

set -euo pipefail

NOTES_DIR="$HOME/Documents/personal/notes"
EDITOR="${EDITOR:-nvim}"

mkdir -p "$NOTES_DIR"
cd "$NOTES_DIR" || exit 1

list_notes() {
  find . -type f -name "*.md" | sed 's|^\./||' | sort -f
}

search_notes() {
  local selection
  selection=$(list_notes | fzf --border-label=" Search notes " --reverse \
    --preview 'head -n 50 {}' --preview-window=right:50% || true)
  if [ -n "$selection" ] && [ -f "$selection" ]; then
    exec "$EDITOR" "$NOTES_DIR/$selection"
  fi
}

create_note() {
  local note_name
  read -r -p "Note name (e.g., work/meeting-minutes): " note_name
  if [ -z "$note_name" ]; then
    exit 0
  fi
  if [[ "$note_name" != *.md ]]; then
    note_name="${note_name}.md"
  fi
  local full_path="$NOTES_DIR/$note_name"
  mkdir -p "$(dirname "$full_path")"
  exec "$EDITOR" "$full_path"
}

delete_note() {
  local selection
  selection=$(list_notes | fzf --border-label=" Delete note " --reverse \
    --preview 'head -n 50 {}' --preview-window=right:50% || true)
  if [ -z "$selection" ] || [ ! -f "$selection" ]; then
    exit 0
  fi
  local confirm
  confirm=$(printf "No\nYes\n" | fzf --border-label=" Trash '$selection'? > " --reverse || true)
  if [[ "$confirm" == "Yes" ]]; then
    trash-put "$NOTES_DIR/$selection"
  fi
}

case "${1:-}" in
-c | --create)
  create_note
  ;;
-d | --delete)
  delete_note
  ;;
*)
  search_notes
  ;;
esac
