#!/usr/bin/env bash

set -euo pipefail

NOTES_DIR="$HOME/Documents/personal/notes"
EDITOR="${EDITOR:-nvim}"
TERMINAL="${TERMINAL:-foot}"
DMENU="${DMENU:-vicinae dmenu}"

mkdir -p "$NOTES_DIR"
cd "$NOTES_DIR" || exit 1

search_notes() {
  local selection
  selection=$(find . -type f -name "*.md" | sed 's|^\./||' | sort -f | $DMENU --placeholder "Search notes")
  if [ -n "$selection" ] && [ -f "$selection" ]; then
    exec "$TERMINAL" -e "$EDITOR" "$NOTES_DIR/$selection"
  fi
}

create_note() {
  local note_name
  note_name=$(printf '' | $DMENU --placeholder "e.g., work/meeting-minutes")
  if [ -z "$note_name" ]; then
    exit 0
  fi
  if [[ "$note_name" != *.md ]]; then
    note_name="${note_name}.md"
  fi
  local full_path="$NOTES_DIR/$note_name"
  mkdir -p "$(dirname "$full_path")"
  exec "$TERMINAL" -e "$EDITOR" "$full_path"
}

delete_note() {
  local selection
  selection=$(find . -type f -name "*.md" | sed 's|^\./||' | sort -f | $DMENU --placeholder "Delete Note")
  if [ -z "$selection" ] || [ ! -f "$selection" ]; then
    exit 0
  fi
  local confirm
  confirm=$(printf "n ➜ No\ny ➜ Yes\n" | $DMENU --placeholder "Trash '$selection'?")
  if [[ "$confirm" == *"Yes"* ]]; then
    trash-put "$NOTES_DIR/$selection"
  fi
}

case "${1:-}" in
-c | --create)
  create_note
  ;;
-d | --delete)
  delete_note
  ;;
*)
  search_notes
  ;;
esac
