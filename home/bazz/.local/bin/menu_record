#!/usr/bin/env bash

set -euo pipefail

DMENU="${DMENU:-vicinae dmenu}"

while true; do
  MENU="1 ➜ 󰑋 Record Screen\n2 ➜ 󰩬 Record Regional"

  if [ -f /tmp/gpu-recorder.pid ]; then
    MENU="$MENU\n3 ➜ 󰙦 Stop"
  fi

  SUB=$(printf '%b\n' "$MENU" | $DMENU --placeholder "Choose")

  if [ -z "$SUB" ]; then
    exit 0
  fi

  case "$SUB" in
  *"Record Screen")
    wl-record -f
    exit 0
    ;;
  *"Record Regional")
    wl-record -r
    exit 0
    ;;
  *"Stop")
    wl-record -k && pkill -SIGRTMIN+2 waybar
    exit 0
    ;;
  esac
done
