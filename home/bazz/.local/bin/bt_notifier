#!/usr/bin/env bash

set -e

IGNORE_WORDS=("mouse" "keyboard")

IGNORE_PATTERN=$(
  IFS='|'
  echo "${IGNORE_WORDS[*]}"
)

while read -r line; do

  if [[ "$line" =~ ^UDEV.*\ ([[:alpha:]]+)\ .*/devices/ ]]; then
    action="${BASH_REMATCH[1]}"

  elif [[ "$line" =~ ^NAME=\"(.*)[[:space:]]*\(AVRCP\)\"$ ]]; then
    device_name="${BASH_REMATCH[1]}"

    if [[ "${device_name,,}" =~ ($IGNORE_PATTERN) ]]; then
      continue
    fi

    case "$action" in
    add)
      state="Connected"
      icon="bluetooth"
      ;;
    remove)
      state="Disconnected"
      icon="bluetooth-disabled"
      ;;
    *) continue ;;
    esac

    notify-send -a btnot -i "$icon" "$device_name" "$state"
  fi

done < <(udevadm monitor --udev --subsystem-match=input --property)
