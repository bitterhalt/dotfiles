#!/usr/bin/env bash

set -e

while read -r line; do

  if [[ "$line" =~ ^UDEV.*\ ([[:alpha:]]+)\ .*/devices/ ]]; then
    action="${BASH_REMATCH[1]}"

  elif [[ "$line" =~ ^NAME=\"(.*)[[:space:]]*\(AVRCP\)\"$ ]]; then
    device_name="${BASH_REMATCH[1]}"

    case "$action" in
    add) state="Connected" ;;
    remove) state="Disconnected" ;;
    *) continue ;;
    esac

    notify-send -a btnot -i bluetooth "$device_name" "$state"
  fi

done < <(udevadm monitor --udev --subsystem-match=input --property)
