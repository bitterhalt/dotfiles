#!/usr/bin/env bash

set -e

IGNORE_WORDS=("mouse" "keyboard")
IGNORE_PATTERN=$(
  IFS='|'
  printf '%s' "${IGNORE_WORDS[*]}"
)

action=""

while read -r line; do
  if [[ "$line" =~ ^UDEV.*\ (add)\ .*/devices/ ]]; then
    action="add"

  elif [[ "$line" =~ ^NAME=\"(.*)[[:space:]]*\(AVRCP\)\"$ ]] &&
    [[ "$action" == "add" ]]; then

    device_name="${BASH_REMATCH[1]}"

    if [[ ! "${device_name,,}" =~ ($IGNORE_PATTERN) ]]; then
      notify-send -a btnot -i bluetooth "$device_name" "Connected"
    fi

    action=""
  fi
done < <(
  udevadm monitor --udev --subsystem-match=input --property
)
