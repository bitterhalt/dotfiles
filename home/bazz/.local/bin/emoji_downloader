#!/usr/bin/env bash

set -e

EMOJI_DIR="$HOME/.local/share/emoji"
EMOJI_FILE="$EMOJI_DIR/emoji.txt"

mkdir -p "$EMOJI_DIR"

if [ -s "$EMOJI_FILE" ]; then
  echo "Emoji list already exists: $EMOJI_FILE"
  exit 0
fi

echo "Downloading emoji list..."

TMP_FILE="$(mktemp)"
if curl -sSL "https://unicode.org/Public/emoji/latest/emoji-test.txt" |
  sed -ne 's/^.*; fully-qualified.*# \(\S*\) \S* \(.*$\)/\1 \2/p' \
    >"$TMP_FILE" && [ -s "$TMP_FILE" ]; then
  mv "$TMP_FILE" "$EMOJI_FILE"
  echo "Saved to $EMOJI_FILE"
else
  rm -f "$TMP_FILE"
  echo "Download failed" >&2
  exit 1
fi
