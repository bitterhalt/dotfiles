#!/usr/bin/env bash

OPTIONS="Weather\nMoon\nSunshine"
FLAGS="-d  -w 25 --minimal-lines"

if ! command -v linecast &>/dev/null; then
  notify-send -a "Linecast" -t 10000 \
    "Linecast not installed" \
    "Install linecast to use the weather menu"
  exit 1
fi

CHOICE=$(echo -e "$OPTIONS" | fuzzel $FLAGS)

[ -z "$CHOICE" ] && exit 0

case "$CHOICE" in
"Weather")
  $TERMINAL -a Linecast -T Weather-Peek -e linecast weather
  ;;
"Moon")
  $TERMINAL -a Linecast -T Weather-Peek -e linecast moon
  ;;
"Sunshine")
  $TERMINAL -a Linecast -T Weather-Peek -e linecast sunshine
  ;;
*)
  exit 1
  ;;
esac
