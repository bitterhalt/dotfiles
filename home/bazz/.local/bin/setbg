#!/usr/bin/env bash

BGCOL="121212"

get_resolution() {
  if ! command -v wlr-randr >/dev/null 2>&1; then
    echo "Error: wlr-randr is not installed." >&2
    return 1
  fi

  local out
  out=$(wlr-randr | awk '
    /^[^[:space:]]/ { enabled = 0 }
    /Enabled: yes/ { enabled = 1 }
    /current/ {
      if (enabled && match($0, /[0-9]+x[0-9]+/)) {
        split(substr($0, RSTART, RLENGTH), r, "x")
        print r[1], r[2]
        exit
      }
    }
  ')

  if [[ -n "$out" ]]; then
    local res=($out)
    local w="${res[0]}"
    local h="${res[1]}"

    local is_niri="false"
    if pgrep -x niri >/dev/null 2>&1; then
      is_niri="true"
    fi

    echo "$w $h $is_niri"
    return 0
  fi

  return 1
}

_apply_wallpaper() {
  local path="$1"

  [[ -f "$path" ]] || {
    echo "Error: '$path' does not exist." >&2
    return 1
  }

  local res_data
  res_data=$(get_resolution) || {
    echo "Error: failed to detect resolution." >&2
    return 1
  }

  local res=($res_data)
  local w="${res[0]}"
  local h="${res[1]}"
  local is_niri="${res[2]}"

  local dir="$HOME/.local/share/wall/"
  local out="${dir}wallpaper.png"
  local lockscreen="${dir}lockscreen.png"

  mkdir -p "$dir"

  vipsthumbnail "$path" \
    --size "${w}x${h}" \
    --output "$out" || return 1

  awww img "$out" --transition-type=any \
    --transition-step=60 \
    --transition-fps=60 \
    --transition-duration=.7

  if [[ "$is_niri" == "true" ]]; then
    convert "$out" -blur 0x55 -modulate 80 "$lockscreen"
    awww img -n overview "$lockscreen" --transition-type=none
  fi
}

_refresh_portals() {
  local portals=(
    "xdg-desktop-portal-gtk"
    "xdg-desktop-portal-gnome"
    "xdg-desktop-portal-hyprland"
    "xdg-desktop-portal-wlr"
  )

  for portal in "${portals[@]}"; do
    if systemctl --user is-active "$portal" >/dev/null 2>&1; then
      echo "Restarting $portal via systemd..."
      systemctl --user restart "$portal"
    else
      if pgrep -f "$portal" >/dev/null 2>&1; then
        echo "Killing active instance of $portal..."
        pkill -f "$portal"
        sleep 0.2
      fi

      for libdir in /usr/lib /usr/libexec /usr/lib/xdg-desktop-portal; do
        if [[ -x "$libdir/$portal" ]]; then
          echo "Manually starting $portal from $libdir..."
          "$libdir/$portal" &>/dev/null &
          break
        fi
      done
    fi
  done

  if systemctl --user is-active xdg-desktop-portal >/dev/null 2>&1; then
    systemctl --user restart xdg-desktop-portal
  else
    pkill -f xdg-desktop-portal
    for libdir in /usr/lib /usr/libexec; do
      if [[ -x "$libdir/xdg-desktop-portal" ]]; then
        "$libdir/xdg-desktop-portal" &>/dev/null &
        break
      fi
    done
  fi
}

_refresh_apps() {
  # Reload applications
  pkill -x waybar
  waybar &
  makoctl reload
}

setwall() {
  _apply_wallpaper "$1"
}

pywal() {
  _apply_wallpaper "$1" || return 1
  wal -e -n -i "$HOME/.local/share/wall/wallpaper.png"
  _refresh_apps
  _refresh_portals
}

pywal_fixed() {
  local custom_bg

  selection=$(printf "121212 (Default)\nCustom" |
    fuzzel -d --minimal-lines --placeholder "Select background color: ")

  if [[ "$selection" == "Custom" ]]; then
    custom_bg=$(fuzzel -d --minimal-lines --placeholder "Enter hex (e.g. 1A1A1A): ")
    custom_bg="${custom_bg#\#}" # Remove # if present
    [[ -z "$custom_bg" ]] && custom_bg="$BGCOL"
  else
    custom_bg=$(echo "$selection" | awk '{print $1}')
  fi

  _apply_wallpaper "$1" || return 1
  wal -e -n -i "$HOME/.local/share/wall/wallpaper.png" -b "$custom_bg"
  _refresh_apps
  _refresh_portals
}

case "$1" in
-w)
  shift
  setwall "$1"
  ;;
-p)
  shift
  pywal "$1"
  ;;
-pf)
  shift
  pywal_fixed "$1"
  ;;
*)
  echo "Usage: $0 {-w|-p|-pf} path/to/wallpaper"
  exit 1
  ;;
esac
