#!/usr/bin/env bash

sessions=$(tmux list-sessions -F "#{session_name}" 2>/dev/null)

menu() {
  fzf --reverse --border-label " tmux-helper "
}

if [[ -n "$sessions" ]]; then
  options="Attach session\nNew session\nRename session\nDelete session"
else
  options="New session"
fi

choice=$(printf '%b\n' "$options" | menu "Tmux manager")

case "$choice" in
"Attach session")
  target=$(printf '%s\n' "$sessions" | menu "Attach to")
  [[ -n "$target" ]] && "$TERMINAL" -e tmux attach-session -t "$target"
  ;;

"New session")
  read -r -p "Session name (optional): " session_name

  if [[ -z "$session_name" ]]; then
    tmux new-session
  else
    tmux new-session -s "$session_name"
  fi
  ;;

"Rename session")
  target=$(printf '%s\n' "$sessions" | menu "Rename session")
  [[ -z "$target" ]] && exit 0

  read -r -p "New name for $target: " new_name
  [[ -n "$new_name" ]] && tmux rename-session -t "$target" "$new_name"
  ;;

"Delete session")
  target=$(printf '%s\n' "$sessions" | menu "Kill session")
  [[ -z "$target" ]] && exit 0

  confirm=$(printf 'No\nYes\n' | menu "Delete $target?")
  [[ "$confirm" == "Yes" ]] && tmux kill-session -t "$target"
  ;;
esac
