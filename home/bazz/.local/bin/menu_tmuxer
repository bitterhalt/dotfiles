#!/usr/bin/env bash

TERMINAL="${TERMINAL:-foot}"
menu=(dmenu-runner --minimal-lines)

sessions=$(tmux list-sessions -F "#{session_name}" 2>/dev/null)

if [ -n "$sessions" ]; then
  options=("Attach session" "New session" "Delete session")
else
  options=("New session")
fi

choice=$(printf '%s\n' "${options[@]}" |
  "${menu[@]}" -p "Tmux manager:") || exit 0

case "$choice" in
"Attach session")
  target=$(printf '%s\n' "$sessions" |
    "${menu[@]}" -p "Attach to:") || exit 0

  [ -n "$target" ] &&
    "$TERMINAL" -e tmux attach-session -t "=$target"
  ;;

"New session")
  session_name=$("${menu[@]}" -l 0 \
    -p "Name (optional):" </dev/null) || exit 0

  if [ -z "$session_name" ]; then
    "$TERMINAL" -e tmux new-session
  else
    "$TERMINAL" -e tmux new-session -s "$session_name"
  fi
  ;;

"Delete session")
  target=$(printf '%s\n' "$sessions" |
    "${menu[@]}" -p "Kill session:") || exit 0

  [ -n "$target" ] || exit 0

  confirm=$(printf '%s\n' No Yes |
    "${menu[@]}" -p "Delete $target?") || exit 0

  if [ "$confirm" = "Yes" ]; then
    tmux kill-session -t "=$target"
  fi
  ;;
esac
