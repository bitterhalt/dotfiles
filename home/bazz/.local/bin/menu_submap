#!/usr/bin/env bash

# ==========================================================
# Description: expandable wlr-which-key clone using Vicinae
# ==========================================================

DMENU="${DMENU:-vicinae dmenu}"

run_menu() {
  local is_submenu=false

  if [[ "$1" == "-sub" ]]; then
    is_submenu=true
    shift
  fi

  local menu_title="$1"
  shift
  local items=("$@")

  while true; do
    local menu_input=""
    local i=1
    for item in "${items[@]}"; do
      local label="${item%%|*}"
      menu_input+="$i ➜ $label\n"
      ((i++))
    done

    if [ "$is_submenu" = true ]; then
      menu_input=".. Back\n$menu_input"
    fi

    local choice
    choice=$(printf '%b' "$menu_input" | $DMENU --placeholder "$menu_title")

    if [ -z "$choice" ]; then exit 0; fi
    if [[ "$choice" == *"Back"* ]]; then return 0; fi

    local chosen_label="${choice#*➜ }"
    for item in "${items[@]}"; do
      local label="${item%%|*}"
      local command="${item#*|}"

      if [[ "$chosen_label" == "$label" ]]; then
        if declare -f "$command" >/dev/null; then
          "$command"
        else
          eval "$command"
          exit 0
        fi
      fi
    done
  done
}

menu_notes() {
  run_menu "Notes" \
    "󰍉 Search|~/.local/bin/menu_notes" \
    "󰎚 New Note|~/.local/bin/menu_notes -c" \
    " TODO|foot -a noteterm -T Notes sh -c 'cd ~/Documents/personal/notes/ && nvim todo.md'" \
    "󰩹 Delete|~/.local/bin/menu_notes -d"
}

menu_packages() {
  run_menu "Packages" \
    "Install Packages|foot -a pacseek -T pacseek -e pacseek -m" \
    "Update|foot -a pop-upgrade -e sup"
}

menu_pass() {
  run_menu "Pass" \
    "Passwords|~/.local/bin/menu_passmenu" \
    "Authenticator|proton-authenticator"
}

menu_settings() {
  run_menu "Settings" \
    "Bash|foot -e nvim ~/.bashrc ~/.config/shell/aliases ~/.config/shell/inputrc" \
    "Foot|foot -e nvim ~/.config/foot/foot.ini" \
    "Vicinae|foot sh -c 'nvim ~/.local/bin/menu_*'" \
    "Mako|foot sh -c 'cd ~/.config/mako/ && nvim *'" \
    "Niri|foot sh -c 'cd ~/.config/niri/ && nvim *'" \
    "Nvim|foot sh -c 'cd ~/.config/nvim && vopen .'" \
    "Pywal|foot -e nvim ~/.local/bin/setbg ~/.config/wal/templates/*" \
    "Swayidle|foot sh -c 'cd ~/.config/swayidle/ && nvim config'" \
    "Waybar|foot sh -c 'cd ~/.config/waybar/ && vopen .'"
}

menu_system() {
  run_menu "System" \
    "󰓃 Wiremix|foot -a wiremix -e wiremix" \
    "󰂯 Bluetooth|foot -a bluetui -e bluetui" \
    "󰖩 Wi-Fi|foot -a impala -e impala" \
    "󰲝 Network Manager|foot -e nmtui" \
    "󰑐 Update System|foot -a pop-upgrade -e sysup" \
    "+ 󰨇 Monitor|submenu_monitor"
}

menu_theming() {
  run_menu "Theming" \
    "Set wallpaper|swayimg --appid swayimg-setwall -g ~/Pictures/wallpaper/" \
    "Set theme|~/.local/bin/menu_theme" \
    "Save theme|~/.local/bin/menu_theme -s"
}

submenu_monitor() {
  run_menu -sub "Monitor" \
    "Atop [AMD GPU Monitor]|foot -T atop -e amdgpu_top --smi" \
    "Btop [System Monitor]|foot -a btop -e btop" \
    "Nethogs [Network Monitor]|foot -a nethogs -e nethogs" \
    "Logs|foot -a foot -T journalctl -e journalctl -f" \
    "Combined|foot -a Sysmon -T Sysmon -e ~/.local/bin/tmux-sysmon.sh"
}

case "${1:-}" in
-notes) menu_notes ;;
-packages) menu_packages ;;
-pass) menu_pass ;;
-settings) menu_settings ;;
-system) menu_system ;;
-theming) menu_theming ;;
*) exit 0 ;;
esac
