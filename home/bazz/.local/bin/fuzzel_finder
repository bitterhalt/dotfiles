#!/usr/bin/env bash

# Fuzzel file finder & web search

DMENU="fuzzel -d -a top --y 24 -l 10 --minimal-lines"
EDITOR="${EDITOR:-nvim}"

QUERY=$($DMENU -w 30 --placeholder="Find files")
[[ -z "$QUERY" ]] && exit 0

# Handle web search: triggers if input starts with "w "
if [[ "$QUERY" =~ ^w[[:space:]]+(.*) ]]; then
  SEARCH_QUERY="${BASH_REMATCH[1]}"

  ENCODED_QUERY=$(printf '%s' "$SEARCH_QUERY" | sed 's/ /+/g')

  xdg-open "https://www.google.com/search?q=${ENCODED_QUERY}" >/dev/null 2>&1 &
  disown
  exit 0
fi

SELECTION=$(
  fd -HI -t f \
    --exclude .icons \
    --exclude Pictures \
    --exclude Videos \
    --exclude bin \
    --exclude icons \
    --exclude lib \
    --exclude lib64 \
    --exclude man \
    "$QUERY" \
    "$HOME" \
    /etc \
    /usr \
    /opt \
    /var \
    /srv \
    2>/dev/null |
    while IFS= read -r file; do
      [[ -L "$file" ]] && continue
      printf '%s\n' "$file"
    done |
    $DMENU -w 55 --placeholder="Select file "
)

if [[ -n "$SELECTION" ]]; then
  MIME=$(file --mime-type -b "$SELECTION")

  if [[ "$MIME" == text/* ||
    "$SELECTION" == *.sh ||
    "$SELECTION" == *.py ||
    "$SELECTION" == *.conf ]]; then

    if [[ "$SELECTION" == "$HOME"* ]]; then
      "${TERMINAL:-alacritty}" -e "$EDITOR" "$SELECTION" &
    else
      "${TERMINAL:-alacritty}" -e pkexec "$EDITOR" "$SELECTION" &
    fi
  else
    xdg-open "$SELECTION" &
  fi

  disown
fi
