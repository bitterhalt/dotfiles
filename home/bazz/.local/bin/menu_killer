#!/usr/bin/env bash

set -euo pipefail

processes=$(ps -u "$USER" -o pid=,comm= | awk '{pid=$1; $1=""; print $0 " (PID:" pid ")"}' | sed 's/^ //')

[[ -z "$processes" ]] && exit 0

selection=$(
  printf "%s\n" "$processes" | dmenu-runner -l 8 -p "!!! Kill process" --index
)

[[ -z "${selection:-}" ]] && exit 0

selected_line=$(printf "%s\n" "$processes" | sed -n "$((selection + 1))p")

pid=$(echo "$selected_line" | grep -o '（PID:[0-9]*）' | grep -o '[0-9]*' || echo "$selected_line" | sed 's/.*(PID:\([0-9]*\))/\1/')
cmd=$(echo "$selected_line" | sed 's/ (PID:[0-9]*)//')

confirm=$(
  printf "No\nYes" | dmenu-runner --minimal-lines -p "Kill $cmd (PID $pid)? "
)

[[ "$confirm" != "Yes" ]] && exit 0

kill -9 "$pid" 2>/dev/null
