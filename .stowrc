# Stow reads this file from the current directory, so it only applies when
# stow runs from the repository root. dotter add changes into the repo first.
--target=~/
--ignore=DS_Store
--ignore=atuin/*
# Local secrets, never stowed or committed.
--ignore=40-private.conf
# Desktop files rewritten by applications (Thunderbird, Thunar, xdg-user-dirs)
# using a temp file and rename. A symlink would be replaced by a real file, so
# keep these live files real and let dotter add absorb their contents into the
# repo copies instead of linking them.
--ignore=mimeapps\.list
--ignore=user-dirs\.dirs
