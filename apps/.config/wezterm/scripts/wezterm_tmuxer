#!/usr/bin/env bash

menu=(dmenu-runner --minimal-lines)

# talk to the mux server directly, not to whichever GUI process wezterm picks
export WEZTERM_UNIX_SOCKET="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/wezterm/sock"
cli=(wezterm cli)

sessions=$("${cli[@]}" list --format json 2>/dev/null |
  jq -r '.[].workspace' 2>/dev/null | sort -u)

if [ -n "$sessions" ]; then
  options=("Attach session" "New session" "Delete session")
else
  options=("New session")
fi

open_workspace() {
  setsid -f wezterm connect unix --workspace "$1" >/dev/null 2>&1
}

choice=$(printf '%s\n' "${options[@]}" |
  "${menu[@]}" -p "Wezterm manager") || exit 0

case "$choice" in
"Attach session")
  target=$(printf '%s\n' "$sessions" |
    "${menu[@]}" -p "Attach to:") || exit 0

  [ -n "$target" ] && open_workspace "$target"
  ;;

"New session")
  session_name=$("${menu[@]}" -l 0 \
    -p "Name (optional):" </dev/null) || exit 0

  [ -z "$session_name" ] && session_name="session-$(date +%H%M%S)"
  open_workspace "$session_name"
  ;;

"Delete session")
  target=$(printf '%s\n' "$sessions" |
    "${menu[@]}" -p "Kill session:") || exit 0

  [ -n "$target" ] || exit 0

  confirm=$(printf '%s\n' No Yes |
    "${menu[@]}" -p "Delete $target?") || exit 0

  if [ "$confirm" = "Yes" ]; then
    "${cli[@]}" list --format json |
      jq -r --arg ws "$target" '.[] | select(.workspace == $ws) | .pane_id' |
      xargs -r -n1 "${cli[@]}" kill-pane --pane-id
  fi
  ;;
esac
