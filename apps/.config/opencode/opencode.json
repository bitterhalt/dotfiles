{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "ollama": {
      "package": "@opencode-ai/ai/providers/openai-compatible",
      "name": "Ollama",
      "settings": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwythos-v2": {
          "name": "Qwythos 9B",
          "capabilities": {
            "tools": true,
            "reasoning": {
              "supported": true
            }
          },
          "limit": {
