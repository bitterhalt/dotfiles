# Python caches
__pycache__/
*.py[cod]
.#*

# Local secrets: kept in the working tree, never committed
core/.config/environment.d/40-private.conf
.env
*.key
*.pem
id_rsa*
brave*
intent.cache
firefox*

# Local-only development files (kept for agent work, not published)
core/.config/quickshell/tests/
core/.config/quickshell/lock-test.qml
/AGENTS.md

# OpenCode local service credentials
apps/.config/opencode/service.json

# Runtime state, regenerated locally
apps/.config/htop/htop_history

# Desktop registrations and caches written by applications into the stowed
# ~/.local/share/applications directory (Thunderbird handler registration,
# update-desktop-database).
bin/.local/share/applications/userapp-*.desktop
bin/.local/share/applications/mimeinfo.cache
