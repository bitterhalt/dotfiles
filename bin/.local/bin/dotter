#!/usr/bin/env bash
set -euo pipefail

DOTFILES="$HOME/Documents/projects/dotfiles"
cd "$DOTFILES"

echo "=== 1. Stowing Dotfiles Packages ==="
stow -v apps bin desktop env shell

echo -e "\n=== 2. Exporting Package Manifests ==="
echo "Dumping pacman package list..."
pacman -Qqe >"$DOTFILES/pkglist.txt" 2>/dev/null || echo "pacman not found, skipping."

echo "Dumping pipx package list..."
if command -v pipx &>/dev/null; then
  pipx list --short >"$DOTFILES/pipxlist.txt" 2>/dev/null || pipx list >"$DOTFILES/pipxlist.txt"
else
  echo "pipx not found, skipping."
fi

echo -e "\n=== 3. Running Helpers ==="
if command -v niri_keybind_parser.py &>/dev/null; then
  echo "Running Niri keybind parser..."
  niri_keybind_parser.py || true
fi

echo -e "\n=== 4. Git Sync ==="
if [[ -n $(git status --porcelain) ]]; then
  echo "Changes detected in dotfiles repository (including package lists)."
  git status -s

  read -p "Do you want to commit and push these changes? (y/N) " -n 1 -r
  echo
  if [[ $REPLY =~ ^[Yy]$ ]]; then
    read -p "Enter commit message (default: 'update dotfiles and manifests'): " msg
    msg=${msg:-"update dotfiles and manifests"}

    git add .
    git commit -m "$msg"
    git push
    echo "[✓] Dotfiles successfully committed and pushed!"
  fi
else
  echo "[✓] Working tree is clean. No changes to commit."
fi

echo -e "\n=== Dotter completed successfully! ==="
