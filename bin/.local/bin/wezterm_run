#!/usr/bin/env bash
# Terminal compatibility wrapper for WezTerm.

class=()

while [[ $# -gt 0 ]]; do
  case "$1" in
  -e | --execute)
    shift
    break
    ;;
  --class | --app-id)
    [[ $# -ge 2 ]] || exit 2
    class=(--class "$2")
    shift 2
    ;;
  --class=*)
    class=(--class "${1#*=}")
    shift
    ;;
  --)
    shift
    break
    ;;
  *)
    break
    ;;
  esac
done

if [[ $# -gt 0 ]]; then
  exec wezterm start --always-new-process "${class[@]}" -- "$@"
else
  exec wezterm start --always-new-process "${class[@]}"
fi
