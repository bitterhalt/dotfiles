#!/usr/bin/env bash
# Forked version of https://github.com/elifouts/MyFetch/tree/master

kernel=$(uname -r | cut -d- -f1)
USER=$(whoami)
host=$(cat /proc/sys/kernel/hostname)
. /etc/os-release
os=$PRETTY_NAME

# Distro icons: most distros use the default Linux glyph.
declare -A ico=([arch]='󰣇' [nixos]='󱄅' [linuxmint]='󰣭' [debian]='' [ubuntu]='' [fedora]='' [opensuse]='' [opensuse-leap]='' [opensuse-tumbleweed]='')
osi=${ico[${ID%% *}]-}

ki=''; di='󰧨'; ti='󰞷'; pi='󰏔'; ui='󰅶'; ai='󱦟'

# Package managers: name -> count command.
declare -A pm=(
  [dpkg-query]='dpkg-query -f "\${binary:Package}\n" -W | wc -l'
  [dnf]='dnf list installed | wc -l'
  [pacman]='pacman -Q | wc -l'
  [zypper]='zypper se | wc -l'
  [nix-env]='nix-store -q --requisites /run/current-system/sw | wc -l'
)
manager=$(basename "$(command -v "${!pm[@]}" 2>/dev/null | head -1)")
if [ -n "${pm[$manager]}" ]; then
  packages=$(eval "${pm[$manager]}")
else
  packages=$(ls /usr/bin | wc -l); manager=bin
fi
packages=${packages#"${packages%%[![:space:]]*}"}
manager=${manager%-query}

# Uptime (days, hours, minutes)
IFS=. read -r s _ </proc/uptime
d=$((s / 86400)); h=$((s / 3600 % 24)); m=$((s / 60 % 60))
uptime="$([ $d -gt 0 ] && printf '%s day%s, ' "$d" "$([ $d -gt 1 ] && echo s)")"
uptime+="$([ $h -gt 0 ] && printf '%s hour%s, ' "$h" "$([ $h -gt 1 ] && echo s)")"
uptime+="$([ $m -gt 0 ] && printf '%s min%s' "$m" "$([ $m -gt 1 ] && echo s)")"
uptime=${uptime%, }

# DE/WM
de=${XDG_CURRENT_DESKTOP:-${XDG_SESSION_DESKTOP:-${DESKTOP_SESSION:-N/A}}}
wmlist='i3|bspwm|sway|dwm|awesome|xmonad|qtile|herbstluftwm|openbox|icewm|fluxbox|spectrwm|stumpwm|wmaker|fvwm2|fvwm3|musca|monsterwm|dwl|hyprland|river|wayfire|kwin_x11|kwin_wayland|mutter|xfwm4|marco|metacity|compiz|enlightenment|cwm|2bwm|catwm'
wm=$(pgrep -x -l "$wmlist" 2>/dev/null | awk '{print $2; exit}')
wm=${wm:-N/A}
dewm=${de}/${wm}; dewm=${dewm#N/A/}; dewm=${dewm%/N/A}
[ "$dewm" = N/A/ ] && dewm=N/A

# Terminal
term=${TERM_PROGRAM:-${TERM:-N/A}}
if [ "$term" = "$TERM" ] && [[ $TERM == xterm* ]]; then
  ppid_name=$(ps -p "$PPID" -o comm= 2>/dev/null | sed 's/^-//')
  term=${ppid_name:-$TERM}
fi

# OS age (days since filesystem birth/install)
osbirth=$(stat -c %W / 2>/dev/null)
[ "$osbirth" = 0 ] && osbirth=$(stat -c %Y /lost+found 2>/dev/null)
case $osbirth in ''|0|*[!0-9]*) osage=N/A ;; *) osage="$((($(date +%s)-osbirth)/86400)) days" ;; esac

printf '\n  \033[1;33m%s\033[31m@\033[1;34m%s\033[0m\n  \033[1;35m%s  \033[0m%s\n  \033[1;35m%s  \033[0m%s\n  \033[1;35m%s  \033[0m%s\n  \033[1;35m%s  \033[0m%s\n  \033[1;35m%s  \033[0m%s (%s)\n  \033[1;35m%s  \033[0m%s\n  \033[1;35m%s  \033[0mAge %s\n\n' \
  "$USER" "$host" "$osi" "$os" "$ki" "$kernel" "$di" "$dewm" "$ti" "$term" \
  "$pi" "$packages" "$manager" "$ui" "$uptime" "$ai" "$osage"
